relationship rel_dDepartment
	fromColumn: fEmployeeTurnover.department_key
	toColumn: dDepartment.department_key
	crossFilteringBehavior: oneDirection

relationship rel_dSalaryRange
	fromColumn: fEmployeeTurnover.salary_key
	toColumn: dSalaryRange.salary_key
	crossFilteringBehavior: oneDirection

relationship rel_dTenureBucket
	fromColumn: fEmployeeTurnover.tenure_bucket_key
	toColumn: dTenureBucket.tenure_bucket_key
	crossFilteringBehavior: oneDirection

relationship rel_dPerformanceCluster
	fromColumn: fEmployeeTurnover.performance_cluster_key
	toColumn: dPerformanceCluster.performance_cluster_key
	crossFilteringBehavior: oneDirection

relationship rel_dExitArchetype
	fromColumn: fEmployeeTurnover.exit_archetype_key
	toColumn: dExitArchetype.exit_archetype_key
	crossFilteringBehavior: oneDirection
