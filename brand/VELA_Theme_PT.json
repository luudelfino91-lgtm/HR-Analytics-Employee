{
  "name": "VELA People Analytics — PT-BR",
  "dataColors": [
    "#2A6FB8",
    "#E8833A",
    "#1B9E8F",
    "#7B5EA7",
    "#C43A5E",
    "#B8912E",
    "#4A7C8C",
    "#8C5E3C"
  ],
  "background": "#FBFBF9",
  "secondBackground": "#F2F4F6",
  "foreground": "#0F2A3D",
  "foregroundNeutralSecondary": "#5A6B7A",
  "foregroundNeutralTertiary": "#8A99A6",
  "tableAccent": "#2A6FB8",
  "good": "#1B9E8F",
  "neutral": "#8A99A6",
  "bad": "#C43A5E",
  "maximum": "#C43A5E",
  "center": "#E8833A",
  "minimum": "#1B9E8F",
  "hyperlink": "#2A6FB8",
  "textClasses": {
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 15,
      "color": "#0F2A3D"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#0F2A3D"
    },
    "callout": {
      "fontFace": "Segoe UI Light",
      "fontSize": 36,
      "color": "#0F2A3D"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#5A6B7A"
    },
    "largeTitle": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 20,
      "color": "#0F2A3D"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E4E8EC"
              }
            },
            "radius": 8
          }
        ],
        "visualHeader": [
          {
            "show": true,
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "foreground": {
              "solid": {
                "color": "#8A99A6"
              }
            },
            "border": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#0F2A3D"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 12,
            "alignment": "left",
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#5A6B7A"
              }
            },
            "fontSize": 9,
            "fontFamily": "Segoe UI"
          }
        ],
        "categoryAxis": [
          {
            "showAxisTitle": false,
            "labelColor": {
              "solid": {
                "color": "#8A99A6"
              }
            },
            "fontSize": 9,
            "gridlineShow": false
          }
        ],
        "valueAxis": [
          {
            "showAxisTitle": false,
            "labelColor": {
              "solid": {
                "color": "#8A99A6"
              }
            },
            "fontSize": 9,
            "gridlineShow": true,
            "gridlineColor": {
              "solid": {
                "color": "#EDEFF1"
              }
            },
            "gridlineThickness": 1
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "TopLeft",
            "showTitle": false,
            "labelColor": {
              "solid": {
                "color": "#5A6B7A"
              }
            },
            "fontSize": 9
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#0F2A3D"
              }
            },
            "fontSize": 30,
            "fontFamily": "Segoe UI Light"
          }
        ],
        "categoryLabels": [
          {
            "color": {
              "solid": {
                "color": "#5A6B7A"
              }
            },
            "fontSize": 10
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "fontColor": {
              "solid": {
                "color": "#0F2A3D"
              }
            },
            "fontSize": 10,
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            }
          }
        ],
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#5A6B7A"
              }
            },
            "fontSize": 10
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F2F4F6"
              }
            },
            "transparency": 0
          }
        ]
      }
    }
  }
}